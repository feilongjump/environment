# ============================================================
# 环境变量模板
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改其中的密码、路径等配置
#   3. .env 不会被 git 追踪（已在 .gitignore 中）
#
# 注意：后端服务的配置（如 api、auth 等）放在
#       docker-compose.override.yml 中，本文件不涉及。
# ============================================================


# ----------- MySQL -----------
# 最新的 LTS 版本是 9.7（~2034年4月）
# 另外的 LTS 版本是 8.4（~2032年4月）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
# 数据库数据持久化目录
# 在 Windows 中建议使用相对路径（如 ./mysql_data）或绝对路径
MYSQL_VOLUMES=./mysql_data
# 容器自动重启策略：no | always | unless-stopped | on-failure
MYSQL_RESTART=no


# ----------- PostgreSQL -----------
# 这里只标注了 18 的版本，后续的子版本自动升级是可以接受的
# 子版本的更新，仅用于修复 Bug 和解决安全问题
# 如果无法接受这种，那就带上子版本号 18.x
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
# 容器自动重启策略：no | always | unless-stopped | on-failure
POSTGRES_RESTART=no
# 在 Windows 中不能使用 ./postgres_data 会出现一些问题
# 在 Linux 中，就需要使用 ./xxx 相对定位的方式，或者明确使用绝对定位的方式 /xxx
POSTGRES_VOLUMES=postgres_data


# ----------- Nginx -----------
# Nginx 暴露在宿主机的端口，浏览器通过此端口访问
NGINX_PORT=80
# 容器自动重启策略：no | always | unless-stopped | on-failure
NGINX_RESTART=no
