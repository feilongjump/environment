# 项目密钥：服务器上复制为同目录 .env 并填真实值（.env 被 gitignore，不入库）
# 由 compose.yml 的 env_file: ./api/.env 直接注入容器进程，环境变量优先级高于 config.prod.yaml
# 生成随机密钥：openssl rand -hex 32

# JWT 签名密钥（必改；覆盖 config.prod.yaml 同名项）
JWT_SECRET=

# PostgreSQL 连接串（共享 postgres：env_net 直连 postgres:5432，库 school_uniform_mall）
# 格式：postgres://<user>:<password>@postgres:5432/school_uniform_mall?sslmode=disable
# user/password 取根 .env 的 POSTGRES_USER / POSTGRES_PASSWORD
DATABASE_DSN=
