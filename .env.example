MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
MYSQL_VOLUMES=./mysql_data
# 容器自动重启策略: no, always, unless-stopped, on-failure
MYSQL_RESTART=no

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
# 容器自动重启策略: no, always, unless-stopped, on-failure
POSTGRES_RESTART=no
# 在 Windows 中不能使用 ./postgres_data 会出现一些问题
# 在 Linux 中，就需要使用 ./xxx 相对定位的方式，或者明确使用绝对定位的方式 /xxx
POSTGRES_VOLUMES=postgres_data

# ========== OTB 项目（projects/otb/）==========
# 密钥在 projects/otb/api/.env（模板见同目录 .env.example，由 env_file 直接注入容器）
# 对外端口：API 直连（调试）/ 前端页面
OTB_API_PORT=9418
OTB_WEB_PORT=5918
# 容器重启策略（生产建议 unless-stopped）
OTB_RESTART=unless-stopped

# ========== FlowStock 项目（projects/flowstock/）==========
# 密钥在 projects/flowstock/api/.env（模板见同目录 .env.example）
# 页面与 API 同端口（前端内嵌二进制，无需独立 web 容器）
FLOWSTOCK_PORT=9420
# 容器重启策略（生产建议 unless-stopped）
FLOWSTOCK_RESTART=unless-stopped

# ========== Retail Integration 项目（projects/retail-integration/）==========
# 单二进制多客户实例；客户差异（实例名/租户参数/密钥）在服务器侧 api/config.yaml（不入库）
# 首个实例：V21 服务器（8.134.137.138）；主服务器暂不启用（目录随 git 对齐即可，勿 up）
RETAIL_INTEGRATION_PORT=8090
# 容器重启策略（生产建议 unless-stopped）
RETAIL_INTEGRATION_RESTART=unless-stopped