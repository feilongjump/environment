MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
MYSQL_VOLUMES=./mysql_data
# 容器自动重启策略: no, always, unless-stopped, on-failure
MYSQL_RESTART=no

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
# 容器自动重启策略: no, always, unless-stopped, on-failure
POSTGRES_RESTART=no
# 在 Windows 中不能使用 ./postgres_data 会出现一些问题
# 在 Linux 中，就需要使用 ./xxx 相对定位的方式，或者明确使用绝对定位的方式 /xxx
POSTGRES_VOLUMES=postgres_data

# ========== OTB 项目（projects/otb/）==========
# JWT 密钥（必填，生成：openssl rand -hex 32）；缺失时 api 拒绝启动
OTB_JWT_SECRET=
# 初始管理员密码（仅用户表为空时播种生效，建好后可清空）
OTB_ADMIN_PASSWORD=
# 对外端口：API 直连（调试）/ 前端页面
OTB_API_PORT=9418
OTB_WEB_PORT=5918
# 容器重启策略（生产建议 unless-stopped）
OTB_RESTART=unless-stopped