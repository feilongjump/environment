# FlowStock 密钥：复制为同目录 .env 并填入真实值（.env 已被 gitignore）
#
# 数据库：共享 PostgreSQL（env_net 网络内直连 postgres:5432，用户名/密码与根 .env 的 POSTGRES_* 一致）
# 首次部署需先建库（只做一次）：
#   docker exec -it postgres psql -U postgres -c "CREATE DATABASE flow_stock;"
DATABASE_URL=postgres://postgres:改成根env里的POSTGRES_PASSWORD@postgres:5432/flow_stock?sslmode=disable

# JWT 签名密钥：生成随机串 openssl rand -hex 32
JWT_SECRET=

# 固定值（一般不用改）
DB_DRIVER=postgres
PORT=8081
