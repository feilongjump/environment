# 项目密钥：服务器上复制为同目录 .env 并填真实值（.env 被 gitignore，不入库）
# 由 compose.yml 的 env_file: ./api/.env 直接注入容器进程，环境变量优先级高于 config.prod.yaml
# 生成随机密钥：openssl rand -hex 32

# JWT 签名密钥（必改；覆盖 config.prod.yaml 同名项）
JWT_SECRET=

# PostgreSQL 连接串（共享 postgres：env_net 直连 postgres:5432，库 school_uniform_mall）
# 格式：postgres://<user>:<password>@postgres:5432/school_uniform_mall?sslmode=disable
# user/password 取根 .env 的 POSTGRES_USER / POSTGRES_PASSWORD
DATABASE_DSN=

# ── 微信支付（APIv3 + 微信支付公钥模式，2026-10-27 接入）──────────────────
# 这里只保留 key 名做模板，真实值写服务器同目录 .env，不入库。
# 证书位置：./api/secrets/*.pem（compose 已把 ./api 整个挂进容器，故容器内是 /app/api/secrets/）
# 只放两个文件：apiclient_key.pem（商户私钥）、wechatpay_pub_key.pem（微信支付公钥，非平台证书）
# 注意 apiclient_cert.p12 / apiclient_cert.pem 不要上传，运行时用不到，p12 还含私钥
WECHAT_PAY_MCH_ID=
# 商户 API 证书序列号（openssl x509 -in apiclient_cert.pem -noout -serial），不是公钥 ID
WECHAT_PAY_MCH_SERIAL_NO=
# APIv3 密钥：32 位，商户平台「账户中心 → API 安全」自行设置
WECHAT_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=/app/api/secrets/apiclient_key.pem
# 公钥路径与公钥 ID 必须成对配置；只填一个会启动失败（不降级平台证书）
WECHAT_PAY_PUBLIC_KEY_PATH=/app/api/secrets/wechatpay_pub_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://qibu888.cn/api/app/pay/notify

# 说明：小程序登录用的 appId/appSecret 不走这里，在管理后台「基础设置 → 微信对接」维护
#      （settings 表优先于 config，后台保存后会热重建客户端）。
