# ============================================================
# .gitignore 规则说明
#
# 本项目采用"基础设施（git 追踪）+ 用户配置（gitignore）"分层：
# - 基础设施定义在 docker-compose.yml 中，提交到 git
# - 用户自定义的服务（api、auth 等）放在 docker-compose.override.yml，不提交
# - 前端构建产物、后端二进制、个人配置等都不提交
# ============================================================


# ---------- 环境变量 ----------
# .env 包含个人密码和路径，不提交
# .env.example 是模板，必须提交（已显式不忽略）
.env


# ---------- 数据库持久化目录 ----------
# Docker volume 挂载到宿主机的数据目录
*_data/


# ---------- Claude 工具相关 ----------
.claude/


# ---------- SQL 备份 ----------
*.sql.bak


# ============================================================
# 前端构建产物（nginx 服务的静态文件来源）
# ============================================================
# nginx/sites/<站点名>/ 下的所有内容都是前端 dist 复制进来的，不提交
# 但需要保留 nginx/sites/ 目录本身（用 .gitkeep 占位）
nginx/sites/*
!nginx/sites/.gitkeep
!nginx/sites/*/.gitkeep


# ============================================================
# Nginx 站点配置
# ============================================================
# 用户编写的站点 conf（如 a.conf、b.conf）不提交
# 但 conf.d/ 目录本身和示例文件（default.conf.example）要保留
nginx/conf.d/*.conf
!nginx/conf.d/.gitkeep
!nginx/conf.d/default.conf.example


# ============================================================
# 后端服务（Go、Node、Python 等编译产物）
# ============================================================
# server/<服务名>/ 下的所有内容都是用户编译后手动复制的，不提交
# 但需要保留 server/ 目录本身（用 .gitkeep 占位）
server/*
!server/.gitkeep
!server/*/.gitkeep


# ============================================================
# Docker Compose 用户自定义
# ============================================================
# 每个开发者本地可能跑不同的后端服务
# 这些服务定义在自己的 override 文件里，互不干扰
docker-compose.override.yml
